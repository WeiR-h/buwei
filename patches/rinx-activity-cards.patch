+/// A BuWei card is a pointer. Account identity and all permissions are rechecked by the receiving host.
+#[derive(Clone,Debug,Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct BuWeiCard {pub protocol:u8,pub activity_id:String,pub room:String,pub title:String,pub start:u64,pub end:u64,pub location:String,pub free:usize}
+impl BuWeiCard {
+    fn description(&self)->String {
+        let beijing = chrono::FixedOffset::east_opt(8 * 3600).unwrap();
+        let display = |value:u64| chrono::DateTime::from_timestamp(value as i64,0).map(|t|t.with_timezone(&beijing).format("%Y-%m-%d %H:%M").to_string()).unwrap_or_else(||"时间待核实".into());
+        format!("{} 至 {} · 北京时间\n地点：{}\n分享时剩余 {} 个名额 · 打开后核验最新状态\n补位 · 查看并报名",display(self.start),display(self.end),self.location,self.free)
+    }
+    fn from_message(message:&MessageType)->Result<Self,String>{
+        let data=message.data();let value=data.get("buwei").ok_or("Missing activity card")?;
+        if value.to_string().len()>8192{return Err("Activity card too large".into());}
+        let card:Self=serde_json::from_value(value.clone()).map_err(|_|"Invalid activity card")?;
+        if card.protocol!=2||card.activity_id.len()!=32||!card.activity_id.bytes().all(|b|b.is_ascii_hexdigit())||ruma::OwnedRoomId::try_from(card.room.as_str()).is_err()||card.title.trim().is_empty()||card.title.chars().count()>80||card.location.chars().count()>120||card.start>=card.end||card.free>30{return Err("Invalid activity card".into());}Ok(card)
+    }
+}
