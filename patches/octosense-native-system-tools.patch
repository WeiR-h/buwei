index dfbc709..bc1fc29 100644
--- a/crates/shell/src/ext.rs
+++ b/crates/shell/src/ext.rs
@@ -28,6 +28,43 @@ pub fn linked_modules() -> Vec<&'static dyn AppModule> {
     EXT.get().map(|ext| (ext.linked_modules)()).unwrap_or_default()
 }

+// A package may expose only named tools belonging to its linked native modules.
+// Install before shell startup; no card or model argument can modify the grants.
+static SYSTEM_TOOLS: OnceLock<&'static [(&'static str, &'static str)]> = OnceLock::new();
+
+pub fn install_system_tools(tools: &'static [(&'static str, &'static str)]) {
+    let _ = SYSTEM_TOOLS.set(tools);
+}
+
+pub fn is_package_module(id: &str) -> bool {
+    linked_modules().iter().any(|module| module.id() == id)
+}
+
+pub fn system_tools() -> std::collections::BTreeSet<String> {
+    let linked: Vec<&str> = linked_modules().iter().map(|module| module.id()).collect();
+    system_tools_given(SYSTEM_TOOLS.get().copied().unwrap_or_default(), &linked)
+}
+
+pub fn system_tools_given(tools: &[(&str, &str)], linked: &[&str]) -> std::collections::BTreeSet<String> {
+    tools.iter().filter(|(owner, tool)| linked.contains(owner)
+        && tool.split_once('.').is_some_and(|(prefix, name)| prefix == *owner
+            && !name.is_empty() && name.len() <= 32
+            && name.bytes().all(|c| c.is_ascii_alphanumeric() || c == b'_')))
+        .map(|(_, tool)| tool.to_string()).collect()
+}
+
+#[cfg(test)]
+mod package_tool_tests {
+    #[test]
+    fn package_tools_require_linked_owner_and_exact_namespace() {
+        let tools = [("reading", "reading.prepare_plan"), ("reading", "terminal.run"),
+            ("unknown", "unknown.read"), ("reading", "reading.nested.run"), ("reading", "reading.")];
+        assert_eq!(super::system_tools_given(&tools, &["reading"]),
+            std::collections::BTreeSet::from(["reading.prepare_plan".to_string()]));
+        assert!(super::system_tools_given(&tools, &[]).is_empty());
+    }
+}
+
 pub fn trusted_module(module: &dyn AppModule) -> bool {
     EXT.get().is_some_and(|ext| (ext.trusted_module)(module))
 }
